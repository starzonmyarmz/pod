<div id="cockpit-container" class="room-container">
  <div id="cockpit" class="room" w="7" l="7" h="6">
    <div class="surface port"></div>

    <div class="surface stern">
      <div class="door">
        <input type="radio" name="room" id="from-cockpit-to-bunk" checked />
        <label for="from-cockpit-to-bunk">Bunk</label>
      </div>
    </div>

    <div class="surface starboard"></div>
    <div class="surface bow"></div>
    <div class="surface head"></div>

    <%- include("partials/tri", { id: "console-top", w: 7, l: 2.5, h: 0.5 }) %>
    <%- include("partials/box", { id: "console", w: 7, l: 2.5, h: 2.5 }) %>
    <%- include("partials/box", { id: "cockpit-floor", w: 7, l: 7, h: 1 }) %>
  </div>
</div>
