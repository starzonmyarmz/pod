<div id="bunk-container" class="room-container">
  <div id="bunk" class="room" w="12" l="12" h="7">
    <div class="surface port"></div>
    <%- include("partials/box", { id: "bed", w: 3, l: 6.5, h: 5.5 }) %>

    <%- include("partials/box", { id: "partition", w: 3, l: 0.5, h: 7 }) %>

    <div class="surface stern">
      <%- include("partials/door", { id: "from-bunk-to-reactor" }) %>
    </div>

    <div class="surface starboard"></div>
    <%- include("partials/box", { id: "lockers", w: 3, l: 12, h: 7 }) %>

    <div class="surface bow">
      <%- include("partials/door", { id: "from-bunk-to-cockpit" }) %>
    </div>

    <div class="surface head"></div>

    <%- include("partials/box", { id: "bunk-floor", w: 12, l: 12, h: 0.5 }) %>
  </div>
</div>
