<div id="reactor-container" class="room-container">
  <div id="reactor" class="room" w="7" l="5" h="6">
    <%- include("floor") %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("box", { id: "engine", w: 7, l: 1.5, h: 4, x: 0, y: 0, z: 3.5, hide: "stern" }) %>

    <%- include("door", { id: "from-reactor-to-bunk", tag: "A2", hide: "bow" }) %>
  </div>
</div>
