<div id="reactor">
  <%- include("box", { w: 2.2, l: 2.2, h: 2.2, x: 2.4, y: 2, z: 2.9, c: "case" }) %>

  <div class="cuboid box" w="0.1" l="0.1" h="0.1" x="3.45" y="3" z="4">
    <div class="atom">
      <% for (let i = 0; i < 3; i++) { %>
        <div class="ring">
          <% for (let e = 0; e < 6; e++) { %>
            <% size = Math.random() * (0.16 - 0.1) + 0.1; %>
            <div class="electron">
              <%- include("box", { w: size, l: size, h: size, x: 0, y: 0, z: 0 }) %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include("box", { c: "metal panels", w: 3.4, l: 2.8, h: 1, x: 1.8, y: 0, z: 2.2, hide: locals.hide }) %>
  <%- include("box", { c: "metal panels", w: 3.4, l: 2.2, h: 1, x: 1.8, y: 1, z: 2.8, hide: locals.hide }) %>

  <%- include("pipe", { d: 0.5, l: 1.2, along: true, color: "slate", x: 0.6, y: 1.2, z: 3.6, hide: locals.hide }) %>
  <%- include("pipe", { d: 0.5, l: 2, vertical: true, color: "slate", x: 0.6, y: -0.8, z: 3.6, hide: locals.hide }) %>
  <%- include("pipe", { d: 0.5, l: 4, color: "slate", x: 0.6, y: -0.8, z: -0.4, hide: locals.hide }) %>

  <input type="checkbox" id="reactor-console-zoom" />
  <label for="reactor-console-zoom">
    <%
    const reactorPanelContent = `<div class="reactor-panel">
        <div class="reactor-switch">
          <input type="checkbox" id="power-electric-basic" />
          <label for="power-electric-basic">
            <span class="switch-bezel"><span class="switch-lever"></span></span>
            <span class="switch-label">Electric<br />basic</span>
          </label>
        </div>

        <div class="reactor-switch">
          <input type="checkbox" id="power-life-support" />
          <label for="power-life-support">
            <span class="switch-bezel"><span class="switch-lever"></span></span>
            <span class="switch-label">Life<br />support</span>
          </label>
        </div>

        <div class="reactor-switch">
          <input type="checkbox" id="power-electric-advance" />
          <label for="power-electric-advance">
            <span class="switch-bezel"><span class="switch-lever"></span></span>
            <span class="switch-label">Electric<br />advance</span>
          </label>
        </div>

        <div class="reactor-gauge">
          <div class="gauge-face">
            <div class="gauge-scale"></div>
            <div class="gauge-needle"></div>
          </div>
          <span class="gauge-label">Output</span>
        </div>
      </div>`;
  %>
  <%- include("tri", { id: "reactor-console", metal: true, w: 3.4, l: 0.6, h: 1, x: 1.8, y: 1, z: 2.2, flipy: true, hide: locals.hide, topContent: reactorPanelContent }) %>
  </label>
</div>
