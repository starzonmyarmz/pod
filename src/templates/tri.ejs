<div
  id="<%= id %>"
  class="tri"
  w="<%= w %>"
  l="<%= l %>"
  h="<%= h %>"
  x="<%= x %>"
  y="<%= y %>"
  z="<%= z %>"
  <%- locals.along ? 'along' : '' %>
  <%- locals.flipx ? 'flipx' : '' %>
  <%- locals.flipy ? 'flipy' : '' %>
  <%- locals.mirror ? 'mirror' : '' %>
>
  <div class="face back"></div>
  <div class="face right"></div>
  <div class="face left"></div>
  <div class="face bottom"></div>
  <div class="face slant"></div>
</div>
