<div
  id="<%= id %>"
  class="cuboid tri <%= locals.metal ? 'metal' : '' %>"
  w="<%= w %>"
  l="<%= l %>"
  h="<%= h %>"
  x="<%= x %>"
  y="<%= y %>"
  z="<%= z %>"
  <%- locals.along ? 'along' : '' %>
  <%- locals.flipx ? 'flipx' : '' %>
  <%- locals.flipy ? 'flipy' : '' %>
  <%- locals.mirror ? 'mirror' : '' %>
  <%- locals.hide ? 'hide="' + hide + '"' : '' %>
>
  <div class="face top"></div>
  <div class="face back"></div>
  <div class="face right"></div>
  <div class="face left"></div>
  <div class="face bottom"></div>
</div>
