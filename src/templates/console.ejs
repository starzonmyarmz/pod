<div id="console">
  <input type="checkbox" id="console-zoom" />
  <label for="console-zoom">
    <%- include("box", { w: 5.5, l: 2.5, h: 1.8, x: x, y: y, z: z, hide: locals.hide }) %>
    <%- include("tri", { id: "console-top", w: 5.5, l: 2.5, h: 0.5, x: x, y: y + 1.8, z: z, hide: locals.hide }) %>
  </label>
</div>
