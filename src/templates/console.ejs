<div id="console">
  <input type="checkbox" id="console-zoom" />
  <label for="console-zoom">
    <%- include("box", { w: 5.5, l: 2.5, h: 1.8, x: x, y: y, z: z, hide: locals.hide }) %>

    <%- include("tri", { id: "console-left", w: 1.8, l: 2.5, h: 0.5, x: x, y: y + 1.8, z: z, hide: locals.hide }) %>

    <%
      const kbRows = [
        ["Q","W","E","R","T","Y","U","I","O","P"],
        ["A","S","D","F","G","H","J","K","L"],
        ["Z","X","C","V","B","N","M"],
      ];

      const kbContent = '<div class="keyboard">' +
        kbRows.map(row =>
          '<div class="key-row">' +
          row.map(k => '<span class="key">' + k + '</span>').join('') +
          '</div>'
        ).join('') +
        '<div class="key-row">' +
          '<span class="key wide">CTL</span>' +
          '<span class="key wide space"></span>' +
          '<span class="key wide">ALT</span>' +
        '</div>' +
      '</div>';
    %>

    <%- include("tri", { id: "console-keyboard", w: 1.9, l: 1, h: 0.2, x: x + 1.8, y: y + 1.8, z: z + 1.5, hide: locals.hide, topContent: kbContent }) %>
    <%- include("tri", {
      id: "console-monitor",
      w: 1.9,
      l: 1.5,
      h: 1,
      x: x + 1.8,
      y: y + 2,
      z: z,
      hide: locals.hide,
      topContent: '<button class="crt" command="show-modal" commandfor="monitor-dialog" aria-label="Zoom in on monitor"></button>'
    }) %>

    <%- include("tri", { id: "console-right", w: 1.8, l: 2.5, h: 0.5, x: x + 3.7, y: y + 1.8, z: z, hide: locals.hide }) %>

  </label>
</div>
