  <%- include("box", { id: undefined, c: "chair-arm", w: 0.22, l: 1.1, h: 0.18, x: x, y: y + 2, z: z, hide: locals.hide }) %>
  <%- include("box", { id: undefined, c: "chair-arm", w: 0.22, l: 1.1, h: 0.18, x: x + 1.78, y: y + 2, z: z, hide: locals.hide }) %>
