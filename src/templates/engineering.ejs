    <%- include("pipe", { d: 0.05, l: 5.9, kind: "wire", color: "slate", x: 4.65, y: -0.43, z: -0.45 }) %>
    <%- include("pipe", { d: 0.05, l: 5.9, kind: "wire", color: "red", x: 1.5, y: -0.45, z: -0.45 }) %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("reactor", { hide: "stern" }) %>

    <%- include("locker", { id: "engineering-fusebox", w: 0.4, h: 1.8, l: 1.2, x: 6.6, y: 3, z: 1, hide: "starboard" }) %>

    <%- include("box", { id: undefined, c: "fuse fuse-red", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 4, z: 1.15, hide: "starboard" }) %>
    <%- include("box", { id: undefined, c: "fuse fuse-yellow", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 4, z: 1.45, hide: "starboard" }) %>
    <%- include("box", { id: undefined, c: "fuse fuse-green", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 4, z: 1.75, hide: "starboard" }) %>
    <%- include("box", { id: undefined, c: "fuse fuse-green", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 3.3, z: 1.15, hide: "starboard" }) %>
    <%- include("box", { id: undefined, c: "fuse fuse-gray", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 3.3, z: 1.45, hide: "starboard" }) %>
    <%- include("box", { id: undefined, c: "fuse fuse-red", w: 0.08, l: 0.3, h: 0.5, x: 6.52, y: 3.3, z: 1.75, hide: "starboard" }) %>

    <%- include("pipe", { d: 0.05, l: 2.05, vertical: true, kind: "wire", color: "red", x: 6.95, y: 0.95, z: 1.85, hide: "starboard" }) %>
    <%- include("pipe", { d: 0.05, l: 3.15, kind: "wire", color: "red", x: 6.95, y: 0.95, z: 1.85, hide: "starboard" }) %>
    <%- include("pipe", { d: 0.05, l: 1.8, along: true, kind: "wire", color: "red", x: 5.2, y: 0.95, z: 4.95, hide: "stern" }) %>

    <%- include("pipe", { d: 0.05, l: 1.9, vertical: true, kind: "wire", color: "cyan", x: 6.95, y: 1.1, z: 2, hide: "starboard" }) %>
    <%- include("pipe", { d: 0.05, l: 2.95, kind: "wire", color: "cyan", x: 6.95, y: 1.1, z: 2, hide: "starboard" }) %>
    <%- include("pipe", { d: 0.05, l: 1.8, along: true, kind: "wire", color: "cyan", x: 5.2, y: 1.1, z: 4.9, hide: "stern" }) %>

    <%- include("door", { id: "from-engineering-to-quarters", tag: "A2", hide: "bow" }) %>
