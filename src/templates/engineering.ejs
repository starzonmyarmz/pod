<div id="engineering-container" class="room-container">
  <div id="engineering" class="room" w="7" l="5" h="6">
    <%- include("floor") %>

    <%- include("pipe", { d: 0.15, l: 7.9, along: true, color: "white", x: -0.45, y: -0.28, z: 0.6 }) %>
    <%- include("pipe", { d: 0.12, l: 7.9, along: true, color: "slate", x: -0.45, y: -0.28, z: 0.9 }) %>
    <%- include("pipe", { d: 0.1, l: 7.9, along: true, color: "white", x: -0.45, y: -0.28, z: 1.5 }) %>
    <%- include("pipe", { d: 0.05, l: 7.9, along: true, kind: "wire", color: "red", x: -0.45, y: -0.28, z: 3.5 }) %>
    <%- include("pipe", { d: 0.05, l: 7.9, along: true, kind: "wire", color: "cyan", x: -0.45, y: -0.28, z: 4.5 }) %>

    <%- include("pipe", { d: 0.15, l: 5.9, color: "slate", x: 4, y: -0.45, z: -0.45 }) %>
