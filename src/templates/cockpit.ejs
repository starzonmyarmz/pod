<div id="cockpit-container" class="room-container">
  <div id="cockpit" class="room" w="7" l="7" h="6">
    <div class="surface port"></div>

    <div class="surface stern">
      <%- include("door", { id: "from-cockpit-to-bunk", checked: true }) %>
    </div>

    <div class="surface starboard"></div>
    <div class="surface bow"></div>
    <div class="surface head"></div>

    <%- include("tri", { id: "cockpit-ceiling-corner", w: 7, l: 1, h: 1, x: 0, y: 5, z: 0, flipx: true, flipy: true }) %>
    <%- include("tri", { id: "console-top", w: 7, l: 2.5, h: 0.5, x: 0, y: 1.8, z: 0 }) %>
    <%- include("box", { id: "console", w: 7, l: 2.5, h: 1.8, x: 0, y: 0, z: 0 }) %>
    <%- include("box", { id: "cockpit-floor", w: 7, l: 7, h: 0.5, x: 0, y: -0.5, z: 0 }) %>
  </div>
</div>
