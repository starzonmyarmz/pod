<div id="cockpit-container" class="room-container">
  <div id="cockpit" class="room" w="5.5" l="7" h="6">
    <%- include("floor") %>

    <%- include("pipe", { d: 0.15, l: 6.4, along: true, color: "white", x: -0.45, y: -0.28, z: 1 }) %>
    <%- include("pipe", { d: 0.12, l: 6.4, along: true, color: "slate", x: -0.45, y: -0.28, z: 1.5 }) %>
    <%- include("pipe", { d: 0.1, l: 6.4, along: true, color: "white", x: -0.45, y: -0.28, z: 3 }) %>
    <%- include("pipe", { d: 0.05, l: 6.4, along: true, kind: "wire", color: "red", x: -0.45, y: -0.28, z: 5 }) %>
    <%- include("pipe", { d: 0.05, l: 6.4, along: true, kind: "wire", color: "cyan", x: -0.45, y: -0.28, z: 5.5 }) %>

    <%- include("pipe", { d: 0.15, l: 7.9, color: "slate", x: 2.5, y: -0.45, z: -0.45 }) %>
    <%- include("pipe", { d: 0.12, l: 7.9, color: "white", x: 2.9, y: -0.44, z: -0.45 }) %>
    <%- include("pipe", { d: 0.05, l: 7.9, kind: "wire", color: "slate", x: 3.2, y: -0.43, z: -0.45 }) %>
    <%- include("pipe", { d: 0.05, l: 7.9, kind: "wire", color: "red", x: 4.5, y: -0.45, z: -0.45 }) %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("tri", { id: "cockpit-ceiling-corner", metal: true, w: 5.5, l: 1, h: 1, x: 0, y: 5, z: 0, flipx: true, flipy: true, hide: "bow" }) %>
    <%- include("tri", { id: "cockpit-ceiling-port", metal: true, along: true, w: 7, l: 1, h: 1, x: 0, y: 5, z: 0, flipx: true, hide: "port" }) %>
    <%- include("tri", { id: "cockpit-ceiling-starboard", metal: true, along: true, w: 7, l: 1, h: 1, x: 4.5, y: 5, z: 0, flipx: true, flipy: true, mirror: true, hide: "starboard" }) %>

    <%- include("console", { x: 0, y: 0, z: 0, hide: "bow" }) %>
    <%- include("chair", { id: "chair", x: 1.75, y: 0, z: 3, hide: "bow" }) %>

    <%- include("plane", { id: "window", w: 5.5, h: 2.6, x: 0, y: 2.3, z: 0, hide: "bow" }) %>
    <%- include("plane", { id: "window-port", w: 3, h: 2.6, x: 0, y: 2.3, z: 0, along: true, flipy: true, hide: "port" }) %>
    <%- include("plane", { id: "window-starboard", w: 3, h: 2.6, x: 5.5, y: 2.3, z: 0, along: true, hide: "starboard" }) %>

    <%- include("door", { id: "from-cockpit-to-quarters", checked: true, tag: "A2", hide: "stern" }) %>
  </div>
</div>
