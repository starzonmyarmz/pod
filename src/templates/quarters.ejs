    <%- include("box", { w: 12.9, l: 0.05, h: 0.05, x: -0.45, y: -0.28, z: 5.9, c: "pipe pipe-yellow" }) %>
    <%- include("box", { w: 12.9, l: 0.12, h: 0.12, x: -0.45, y: -0.28, z: 6.5, c: "pipe pipe-green" }) %>
    <%- include("box", { w: 12.9, l: 0.05, h: 0.05, x: -0.45, y: -0.28, z: 11.4, c: "pipe pipe-orange" }) %>

    <%- include("box", { w: 0.15, l: 12.9, h: 0.15, x: 2.2, y: -0.45, z: -0.45, c: "pipe pipe-orange" }) %>
