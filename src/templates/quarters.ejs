    <%- include("box", { w: 0.05, l: 12.9, h: 0.05, x: 9.2, y: -0.43, z: -0.45, c: "pipe pipe-gray" }) %>
    <%- include("box", { w: 0.12, l: 12.9, h: 0.12, x: 9.6, y: -0.45, z: -0.45, c: "pipe pipe-cyan" }) %>
    <%- include("box", { w: 0.05, l: 12.9, h: 0.05, x: 10, y: -0.44, z: -0.45, c: "pipe pipe-red" }) %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("box", { w: 3, l: 8.5, h: 1, x: 0, y: 0, z: 0, hide: "port" }) %>
    <%- include("bed", { x: 0, y: 1, z: 6.5, hide: "port" }) %>
    <%- include("bed", { x: 0, y: 4, z: 6.5, hide: "port" }) %>

    <%- include("cubby", { x: 0, y: 1, z: 6.5, hide: "port" }) %>
    <%- include("cubby", { x: 0, y: 4, z: 6.5, hide: "port" }) %>

    <%- include("box", { id: "partition", w: 3, l: 1.5, h: 7, x: 0, y: 0, z: 6.5, hide: "port" }) %>

    <%- include("plane", { id: "floor-decal", w: 3, h: 3, x: 4.5, y: 0.1, z: 8, flat: true }) %>

    <%- include("locker", { id: "locker-1", x: 9, y: 0, z: 0, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-2", x: 9, y: 0, z: 2.2, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-3", x: 9, y: 0, z: 4.4, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-4", x: 9, y: 0, z: 6.6, hide: "starboard" }) %>

    <%- include("door", { id: "from-quarters-to-engineering", tag: "A3", hide: "stern" }) %>
    <%- include("door", { id: "from-quarters-to-cockpit", tag: "A1", hide: "bow" }) %>
