<div id="quarters-container" class="room-container">
  <div id="quarters" class="room" w="12" l="12" h="7">
    <%- include("floor") %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("box", { id: "top-pillow", w: 2.8, l: 1.5, h: 0.25, x: 0.1, y: 4.75, z: 0.1, hide: "bow port" }) %>
    <%- include("box", { id: "top-mattress", w: 2.8, l: 6.3, h: 0.25, x: 0.1, y: 4.5, z: 0.1, hide: "bow port" }) %>
    <%- include("box", { id: "top-bed", w: 3, l: 6.5, h: 0.5, x: 0, y: 4, z: 0, hide: "bow port" }) %>

    <%- include("box", { id: "bottom-pillow", w: 2.8, l: 1.5, h: 0.25, x: 0.1, y: 1.75, z: 0.1, hide: "bow port" }) %>
    <%- include("box", { id: "bottom-mattress", w: 2.8, l: 6.3, h: 0.25, x: 0.1, y: 1.5, z: 0.1, hide: "bow port" }) %>
    <%- include("box", { id: "bottom-bed", w: 3, l: 6.5, h: 1.5, x: 0, y: 0, z: 0, hide: "bow port" }) %>

    <%- include("box", { id: "partition", w: 3, l: 1.5, h: 7, x: 0, y: 0, z: 6.5, hide: "port" }) %>

    <%- include("plane", { id: "floor-decal", w: 3, h: 3, x: 4.5, y: 0.1, z: 8, flat: true }) %>

    <%- include("locker", { id: "locker-1", x: 9, y: 0, z: 0, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-2", x: 9, y: 0, z: 2, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-3", x: 9, y: 0, z: 4, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-4", x: 9, y: 0, z: 6, hide: "starboard" }) %>

    <%- include("door", { id: "from-quarters-to-engineering", tag: "A3", hide: "stern" }) %>
    <%- include("door", { id: "from-quarters-to-cockpit", tag: "A1", hide: "bow" }) %>
  </div>
</div>
