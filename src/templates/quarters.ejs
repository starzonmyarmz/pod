<div id="quarters-container" class="room-container">
  <div id="quarters" class="room" w="12" l="12" h="7">
    <%- include("floor") %>

    <%- include("pipe", { d: 0.15, l: 12.9, along: true, color: "white", x: -0.45, y: -0.28, z: 1.5 }) %>
    <%- include("pipe", { d: 0.12, l: 12.9, along: true, color: "slate", x: -0.45, y: -0.28, z: 2.1 }) %>
    <%- include("pipe", { d: 0.05, l: 12.9, along: true, kind: "wire", color: "red", x: -0.45, y: -0.28, z: 5.3 }) %>
    <%- include("pipe", { d: 0.05, l: 12.9, along: true, kind: "wire", color: "cyan", x: -0.45, y: -0.28, z: 5.9 }) %>
    <%- include("pipe", { d: 0.12, l: 12.9, along: true, color: "white", x: -0.45, y: -0.28, z: 6.5 }) %>
    <%- include("pipe", { d: 0.05, l: 12.9, along: true, kind: "wire", color: "slate", x: -0.45, y: -0.28, z: 11.4 }) %>

    <%- include("pipe", { d: 0.15, l: 12.9, color: "slate", x: 2.2, y: -0.45, z: -0.45 }) %>
    <%- include("pipe", { d: 0.12, l: 12.9, color: "white", x: 2.6, y: -0.44, z: -0.45 }) %>
    <%- include("pipe", { d: 0.05, l: 12.9, kind: "wire", color: "slate", x: 9.2, y: -0.43, z: -0.45 }) %>
    <%- include("pipe", { d: 0.12, l: 12.9, color: "white", x: 9.6, y: -0.45, z: -0.45 }) %>
    <%- include("pipe", { d: 0.05, l: 12.9, kind: "wire", color: "red", x: 10, y: -0.44, z: -0.45 }) %>

    <%- include("wall", { side: "port" }) %>
    <%- include("wall", { side: "starboard" }) %>
    <%- include("wall", { side: "stern" }) %>
    <%- include("wall", { side: "bow" }) %>

    <%- include("box", { w: 3, l: 8.5, h: 1, x: 0, y: 0, z: 0, hide: "port" }) %>
    <%- include("bed", { x: 0, y: 1, z: 6.5, hide: "port" }) %>
    <%- include("bed", { x: 0, y: 4, z: 6.5, hide: "port" }) %>
    <%- include("locker", { w: 3, h: 3, l: 2, x: 0, y: 1, z: 6.5, hide: "port", door: false, facing: "bow" }) %>
    <%- include("locker", { w: 3, h: 3, l: 2, x: 0, y: 4, z: 6.5, hide: "port", door: false, facing: "bow" }) %>
    <%- include("box", { w: 3, l: 0.2, h: 7, x: 0, y: 0, z: 8.3, hide: "port" }) %>

    <input type="checkbox" name="room" id="from-quarters-to-sub" />
    <label for="from-quarters-to-sub">
      <%- include("plane", { id: "hatch", w: 3, h: 3, x: 4.5, y: 0.1, z: 8, flat: true }) %>
    </label>


    <%- include("locker", { id: "locker-1", w: 3, h: 7, l: 2.2, x: 9, y: 0, z: 0, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-2", w: 3, h: 7, l: 2.2, x: 9, y: 0, z: 2.2, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-3", w: 3, h: 7, l: 2.2, x: 9, y: 0, z: 4.4, hide: "starboard" }) %>
    <%- include("locker", { id: "locker-4", w: 3, h: 7, l: 2.2, x: 9, y: 0, z: 6.6, hide: "starboard" }) %>

    <%- include("door", { id: "from-quarters-to-engineering", tag: "A3", hide: "stern" }) %>
    <%- include("door", { id: "from-quarters-to-cockpit", tag: "A1", hide: "bow" }) %>
  </div>
</div>
