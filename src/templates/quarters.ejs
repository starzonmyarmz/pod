<div id="quarters-container" class="room-container">
  <div id="quarters" class="room" w="12" l="12" h="7">
    <%- include("floor") %>

    <%- include("box", { w: 12.9, l: 0.15, h: 0.15, x: -0.45, y: -0.28, z: 1.5, c: "pipe pipe-gray" }) %>
    <%- include("box", { w: 12.9, l: 0.12, h: 0.12, x: -0.45, y: -0.28, z: 2.1, c: "pipe pipe-cyan" }) %>
